# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Postgres do Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings -> API -> Project API keys -> service_role (nao a "anon")
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Qualquer string longa e aleatoria. Nunca reaproveite a mesma chave entre projetos.
JWT_SECRET=troque_por_uma_chave_aleatoria_bem_grande

PORT=3000
